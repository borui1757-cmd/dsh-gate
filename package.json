{
  "name": "dsh-gate",
  "version": "0.1.0",
  "description": "部署前的总门：只约定入口（tools/lab.mjs）与退出码，不约定测试内容。给任意插件跑一遍再放行。",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "testing",
    "fault-injection",
    "contract-testing",
    "fake-host",
    "ci-gate",
    "deploy-gate",
    "sandbox"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./run": "./lib/run.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md"],
  "engines": { "node": ">=20" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "meta": {
      "title": "部署门（自研）",
      "description": "给插件跑它的 tools/lab.mjs（宿主契约 + 故障注入），退出码非 0 就拦下部署"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": { "optional": true }
  }
}
